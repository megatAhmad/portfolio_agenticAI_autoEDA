# LLM Provider Selection
# Options: "azure" or "openrouter"
LLM_PROVIDER=azure

# Azure OpenAI Configuration (if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_GPT4_DEPLOYMENT=gpt-4-turbo
AZURE_GPT35_DEPLOYMENT=gpt-35-turbo

# OpenRouter Configuration (if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=anthropic/claude-3-sonnet

# Model Configuration (Per-Agent Model Selection)
# Leave empty to use provider defaults. Specify models to override for specific agents.
#
# For Azure: Use deployment names (e.g., gpt-4-turbo, gpt-35-turbo)
# For OpenRouter: Use model IDs (e.g., anthropic/claude-3-opus, openai/gpt-4-turbo)
#
# Default models (used when agent-specific model not set)
MODEL_DEFAULT=
MODEL_FAST=

# Per-agent model overrides (optional - leave empty to use defaults)
MODEL_PLANNING_AGENT=
MODEL_SQL_GENERATOR=
MODEL_PYTHON_ANALYST=
MODEL_VISUALIZATION=
MODEL_UNCERTAINTY_SCORER=
MODEL_HITL_CONTROLLER=
MODEL_EMBEDDINGS=

# Example configurations:
# For Azure provider with mixed models:
#   MODEL_DEFAULT=gpt-4-turbo
#   MODEL_FAST=gpt-35-turbo
#   MODEL_UNCERTAINTY_SCORER=gpt-35-turbo
#   MODEL_PYTHON_ANALYST=gpt-4-turbo
#
# For OpenRouter with Claude models:
#   MODEL_DEFAULT=anthropic/claude-3-sonnet
#   MODEL_FAST=anthropic/claude-3-haiku
#   MODEL_SQL_GENERATOR=anthropic/claude-3-opus
#   MODEL_PYTHON_ANALYST=anthropic/claude-3-opus

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics_db
POSTGRES_USER=analyst
POSTGRES_PASSWORD=secure_password

# Application Settings
UNCERTAINTY_THRESHOLD=0.95
SANDBOX_ENABLED=true
MAX_SANDBOX_TIMEOUT=30
MAX_UPLOAD_SIZE_MB=100
CACHE_ENABLED=true

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Langfuse (LLM Observability)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://localhost:3000

# Langfuse Docker Configuration
LANGFUSE_PORT=3000
LANGFUSE_DB_PASSWORD=langfuse_password
LANGFUSE_SECRET=langfuse-secret-change-in-production
LANGFUSE_SALT=langfuse-salt-change-in-production
LANGFUSE_TELEMETRY=true
LANGFUSE_URL=http://localhost:3000
